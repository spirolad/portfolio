---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsSection from '../components/projects/ProjectsSection.astro';
import { formatPeriod, getApiBaseUrl, getPortfolioSubtitle, toImageSrc, type Portfolio } from '../lib/portfolio';

const apiUrl = `${getApiBaseUrl()}/api/portfolio`;
let portfolio: Portfolio | null = null;
let errorMessage = '';

try {
  const response = await fetch(apiUrl, {
    headers: { accept: 'application/json' },
    cache: 'no-store'
  });

  if (!response.ok) {
    errorMessage = `Le backend a répondu ${response.status}`;
  } else {
    portfolio = (await response.json()) as Portfolio;
  }
} catch (error) {
  errorMessage = error instanceof Error ? error.message : 'Impossible de charger le portfolio.';
}

const profile = portfolio?.generalInfo;
const heroPhoto = toImageSrc(profile?.photo);
const projects = portfolio?.projects ?? [];
const projectCount = portfolio?.projects?.length ?? 0;
const skillCount = portfolio?.skills?.length ?? 0;
const experienceCount = portfolio?.experiences?.length ?? 0;
---

<BaseLayout title={`${profile?.name ?? 'Portfolio'} — Présentation`} description={`Portfolio de ${profile?.name ?? 'mon profil'} : projets, compétences et expériences.`}>
  <main class="shell">
    <div class="container">
      {portfolio ? (
        <>
          <section class="hero glass">
            <div class="hero-grid">
              <div>
                <span class="badge">Portfolio · Vue publique</span>
                <h1 class="hero-title">{profile?.name}</h1>
                <p class="hero-copy">
                  {profile?.currentPosition}. Je construis des expériences web propres, lisibles et orientées impact.
                  Cette page présente mon parcours, mes projets et mes compétences à partir du backend en temps réel.
                </p>

                <div class="hero-actions">
                  <a class="button primary" href={`mailto:${profile?.email}`}>Me contacter</a>
                  <button class="button secondary" type="button" data-scroll-to-projects>Voir les projets</button>
                </div>

                <div class="stat-grid">
                  <div class="stat">
                    <strong>{experienceCount}</strong>
                    <span>expérience{experienceCount > 1 ? 's' : ''}</span>
                  </div>
                  <div class="stat">
                    <strong>{projectCount}</strong>
                    <span>projet{projectCount > 1 ? 's' : ''}</span>
                  </div>
                  <div class="stat">
                    <strong>{skillCount}</strong>
                    <span>compétence{skillCount > 1 ? 's' : ''}</span>
                  </div>
                </div>
              </div>

              <aside class="hero-panel">
                {heroPhoto ? (
                  <img class="avatar" src={heroPhoto} alt={profile?.name ?? 'Photo de profil'} />
                ) : (
                  <div class="avatar" style="display:grid;place-items:center;font-size:1.2rem;color:var(--muted);">Photo à venir</div>
                )}
                <div class="panel-body">
                  <div class="meta">{profile?.email}</div>
                  <h2 style="margin:0.4rem 0 0.35rem;">{profile?.currentPosition}</h2>
                  <p class="meta" style="line-height:1.65;margin:0;">{getPortfolioSubtitle(portfolio)}</p>
                </div>
              </aside>
            </div>
          </section>

          <section id="experience" class="section glass">
            <h2>Expériences</h2>
            <div class="timeline">
              {portfolio.experiences.length > 0 ? portfolio.experiences.map((exp) => (
                <article class="timeline-item">
                  <div class="topline">
                    <strong>{exp.company}</strong>
                    <span>{formatPeriod(exp.startDate, exp.endDate)}</span>
                  </div>
                  <h3>{exp.position}</h3>
                  <ul>
                    {(exp.mission ?? []).map((mission) => <li>{mission}</li>)}
                  </ul>
                </article>
              )) : <p class="meta">Aucune expérience disponible.</p>}
            </div>
          </section>

          <ProjectsSection projects={projects} />

          <section id="competences" class="section glass">
            <h2>Compétences</h2>
            <div class="skill-columns">
              {Array.from(new Map(portfolio.skills.map((skill) => [skill.category.name, [] as string[]]))).map(([categoryName]) => {
                const skills = portfolio.skills.filter((skill) => skill.category.name === categoryName).map((skill) => skill.name);
                return (
                  <article class="skill-group">
                    <div class="topline">
                      <strong>{categoryName}</strong>
                      <span>{skills.length}</span>
                    </div>
                    <div class="skill-list">
                      {skills.map((skill) => <span class="chip">{skill}</span>)}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>

          <section class="section glass">
            <h2>Formation</h2>
            <div class="timeline">
              {portfolio.educations.length > 0 ? portfolio.educations.map((edu) => (
                <article class="timeline-item">
                  <div class="topline">
                    <strong>{edu.institution}</strong>
                    <span>{formatPeriod(edu.startDate, edu.endDate)}</span>
                  </div>
                  <h3>{edu.degree}</h3>
                </article>
              )) : <p class="meta">Aucune formation disponible.</p>}
            </div>
          </section>

          <p class="footer-note container">Données chargées depuis <code>{apiUrl}</code>.</p>
        </>
      ) : (
        <section class="section glass" style="margin-top:2rem;">
          <h2>Impossible de charger le portfolio</h2>
          <p class="lead">{errorMessage}</p>
          <p class="footer-note">Vérifie que le backend tourne bien sur `http://localhost:8080` ou configure `PORTFOLIO_API_URL`.</p>
        </section>
      )}
    </div>
  </main>

  <script is:inline>
    const scrollToProjects = () => {
      const target = document.getElementById('projets');
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    document.querySelectorAll('[data-scroll-to-projects]').forEach((button) => {
      button.addEventListener('click', scrollToProjects);
    });

    const openModal = (id) => {
      const dialog = document.getElementById(id);
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
      }
    };

    document.querySelectorAll('[data-project-modal]').forEach((card) => {
      const modalId = card.getAttribute('data-project-modal');
      if (!modalId) return;

      const trigger = () => openModal(modalId);
      card.addEventListener('click', trigger);
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          trigger();
        }
      });
    });

    document.querySelectorAll('dialog.project-modal').forEach((dialog) => {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    });
  </script>
</BaseLayout>

