---
import { toImageSrc, type Project } from '@/lib/portfolio';

const { project, modalId, summary } = Astro.props as {
  project: Project;
  modalId: string;
  summary: string;
};

const cover = toImageSrc(project.screenshots?.[0]);
const fileExt = (project.technologies?.[0] ?? 'ts').toLowerCase().replace(/[^a-z0-9]/g, '');
const fileName = `${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.${fileExt || 'spec'}`;
---

<article
  class="project-card"
  data-project-modal={modalId}
  tabindex="0"
  role="button"
  aria-haspopup="dialog"
  aria-controls={modalId}
  aria-label={`Détails du projet ${project.name}`}
>
  <div class="project-card-header-bar">
    <div class="project-card-file-tag">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <span>{fileName}</span>
    </div>
    <span class="project-card-arrow">inspect ↗</span>
  </div>

  <div class="project-card-image-wrap">
    {cover ? (
      <img class="project-card-image" src={cover} alt={`Aperçu du projet ${project.name}`} loading="lazy" />
    ) : (
      <div class="project-card-image-empty font-mono">
        <span>// no-visual-preview</span>
      </div>
    )}
  </div>

  <div class="project-card-content">
    <div class="project-card-top">
      <h3 class="project-card-title">{project.name}</h3>
    </div>

    <p class="project-card-summary">{summary}</p>

    {project.technologies && project.technologies.length > 0 && (
      <div class="project-card-tags">
        {project.technologies.map((tech) => (
          <span class="chip">
            <span class="chip-tag-dot" aria-hidden="true"></span>
            <span>{tech}</span>
          </span>
        ))}
      </div>
    )}
  </div>
</article>
