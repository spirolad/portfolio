---
import { toImageSrc, type Project } from '@/lib/portfolio';

const { project, modalId, titleId, summary } = Astro.props as {
  project: Project;
  modalId: string;
  titleId: string;
  summary: string;
};

const screenshots = project.screenshots ?? [];
const technologies = project.technologies ?? [];
---

<dialog id={modalId} class="project-modal" aria-labelledby={titleId}>
  <div class="modal-scroll">
    <div class="modal-header">
      <div>
        <span class="section-eyebrow">Fiche Projet</span>
        <h3 id={titleId} class="modal-title">{project.name}</h3>
      </div>
      <form method="dialog">
        <button class="modal-close-btn" type="submit" aria-label="Fermer la fenêtre">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </form>
    </div>

    {summary && <p class="modal-summary">{summary}</p>}
    {project.description && <p class="modal-description">{project.description}</p>}

    {screenshots.length > 0 && (
      <div class="modal-section">
        <h4 class="modal-section-title">Captures d'écran</h4>
        <div class="modal-gallery">
          {screenshots.map((screenshot, idx) => {
            const src = toImageSrc(screenshot);
            return src ? (
              <img
                src={src}
                alt={`${project.name} - capture ${idx + 1}`}
                class="modal-screenshot"
                loading="lazy"
              />
            ) : null;
          })}
        </div>
      </div>
    )}

    {technologies.length > 0 && (
      <div class="modal-section">
        <h4 class="modal-section-title">Technologies & Outils</h4>
        <div class="skill-chips">
          {technologies.map((tech) => (
            <span class="chip">{tech}</span>
          ))}
        </div>
      </div>
    )}

    <div class="modal-footer">
      {project.link ? (
        <a class="button primary" href={project.link} target="_blank" rel="noopener noreferrer">
          <span>Découvrir le projet</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7" />
          </svg>
        </a>
      ) : (
        <span class="chip">Projet interne / Confidentiel</span>
      )}
    </div>
  </div>
</dialog>
